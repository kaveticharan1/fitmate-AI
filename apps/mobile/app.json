{
  "expo": {
    "name": "FitMate AI",
    "slug": "fitmate-ai",
    "scheme": "fitmate",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1113",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaveticharan.fitmate"
    },
    "android": {
      "package": "com.kaveticharan.fitmate",
      "versionCode": 20,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F1113",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FitMate uses Face ID to unlock your private health data."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-font",
      "./plugins/withReleaseSigning",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitMate uses the microphone only when you tap the mic button to talk to your coach.",
          "speechRecognitionPermission": "FitMate turns your voice into text for the coach chat."
        }
      ],
      "expo-notifications",
      "react-native-health-connect",
      "expo-build-properties",
      [
        "expo-camera",
        {
          "cameraPermission": "FitMate uses the camera to scan food barcodes and take food photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraProguardRules": "# WorkManager (used by background tasks) creates its Room database by reflection.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.work.ListenableWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }\n-keep class androidx.work.impl.background.systemjob.SystemJobService { *; }\n-keep class expo.modules.backgroundtask.** { *; }\n-keep class expo.modules.taskManager.** { *; }"
          }
        }
      ],
      "expo-background-task"
    ]
  }
}

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets FitMate open Android's own "Update" screen for a new version it downloaded. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <application>
    <!-- Lets FitMate hand a copy of its own installer to the app the user picks (WhatsApp, Bluetooth, …). -->
    <provider
      android:name="expo.modules.fitmateshare.FitmateShareProvider"
      android:authorities="${applicationId}.fitmateshare"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/fitmate_share_paths" />
    </provider>
  </application>
</manifest>
